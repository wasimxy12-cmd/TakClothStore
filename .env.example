# Example environment settings for Tak Cloth Store backend
# Copy this file to .env and replace with your own secret values.

ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here
AUTH_SECRET=your_strong_random_secret
AUTH_TOKEN_EXPIRY_MS=3600000
WEB_ORIGIN=http://localhost:3000

# Supabase backend settings
SUPABASE_API_URL=https://your-supabase-endpoint.example.com
SUPABASE_API_KEY=your_supabase_api_key
SUPABASE_INVENTORY_PATH=/inventory
SUPABASE_UPLOAD_PATH=/upload

NODE_ENV=development
